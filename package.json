{
  "name": "kostku",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "vite",
    "build": "vite build",
    "deploy": "npm run build && cd backend && npm install --omit=dev",
    "test": "node tests/security_and_qris_stress_test.cjs",
    "test:security": "node tests/security_and_qris_stress_test.cjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron": "electron .",
    "build:exe": "npm run build && electron-builder --win --x64",
    "build:linux": "npm run build && electron-builder --linux AppImage",
    "cap:sync": "npm run build && npx cap sync",
    "cap:build:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "build": {
    "appId": "id.kostku.app",
    "productName": "KostKu",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "!backend/node_modules/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon-512.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^5.2.0"
  }
}
