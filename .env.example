# =================================================================
# KOSTKU PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env atau .env.production di server Anda
# =================================================================

# --- SERVER & APPLICATION ---
NODE_ENV=production
PORT=3001
CORS_ORIGIN=*

# Lokasi file database JSON (Gunakan path absolut atau volume docker)
DATA_PATH=/app/backend/db.json

# --- PAYMENT GATEWAY: MIDTRANS (QRIS DYNAMIC REAL) ---
# Dapatkan Server Key & Client Key resmi dari https://dashboard.midtrans.com/
# Mode Production: Isi key berawalan "Mid-server-" dan set MIDTRANS_IS_PRODUCTION=true
# Mode Sandbox: Isi key berawalan "SB-Mid-server-" dan set MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Keamanan Webhook Midtrans (True = Wajib validasi SHA-512 signature key)
ENFORCE_WEBHOOK_AUTH=true

# --- EMAIL NOTIFIKASI & KUITANSI (SMTP) ---
# Digunakan untuk auto-dispatch bukti kuitansi sewa kamar digital (PDF/HTML)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifikasi@kostku.id
SMTP_PASS=app-specific-password-anda

# --- GOOGLE AUTHENTICATION (OPSIONAL) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- WHATSAPP GATEWAY (OPSIONAL) ---
# Digunakan untuk notifikasi SLA order otomatis ke warung mitra sekitar kost
WA_GATEWAY_URL=
WA_API_KEY=
